+    padding: 20px;
+  }
+}
+@media (max-width: 599px) {
+  .hp-rail {
+    padding: 4px 12px env(safe-area-inset-bottom);
+    gap: 0;
+  }
+  .hp-brand {
+    display: none;
+  }
+  .hp-rail nav {
+    margin: 0;
+    gap: 0;
+  }
+  .hp-rail nav button {
+    min-height: 48px;
+    gap: 3px;
+  }
+  .hp-canvas-header {
+    padding: 10px 14px;
+    gap: 8px;
+  }
+  .hp-canvas-header h1 {
+    font-size: 16px;
+  }
+  .hp-canvas-header button {
+    min-height: 44px;
+  }
+  .hp-thread__viewport {
+    padding: 24px 14px 16px;
+  }
+  .hp-msg[data-role="user"] .hp-msg__body {
+    max-width: 100%;
+  }
+  .hp-msg[data-role="assistant"] .hp-text-part {
+    padding: 16px;
+    border-radius: 12px;
+  }
+  .hp-msg {
+    margin-bottom: 24px;
+  }
+  .hp-composer {
+    width: calc(100% - 28px);
+    margin-bottom: 12px;
+    padding: 10px;
+  }
