diff --git a/web/src/styles/workbench.css b/web/src/styles/workbench.css
new file mode 100644
index 0000000..8c85661
--- /dev/null
+++ b/web/src/styles/workbench.css
@@ -0,0 +1,671 @@
+/* Reference layout: production composition over the Paper Flame palette.
+ * Shell dimensions still share tokens with useShellWidth; no motion state. */
+.hp-rail {
+  gap: 32px;
+  padding: 22px 10px;
+  border-color: var(--hp-rail-hover);
+}
+.hp-brand {
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  gap: 9px;
+  font-size: 14px;
+  line-height: 20px;
+  letter-spacing: -0.4px;
+}
+.hp-brand-symbol {
+  display: grid;
+  place-items: center;
+  width: 38px;
+  height: 38px;
+  border: 1px solid var(--hp-rail-hover);
+  border-radius: 12px;
+  color: var(--hp-brand);
+}
+.hp-rail nav {
+  gap: 18px;
+  margin-top: 24px;
+}
+.hp-rail nav button {
+  min-height: 72px;
+  gap: 8px;
+  font-size: 12px;
+  border-radius: 12px;
+}
+.hp-rail button svg {
+  width: 21px;
+  height: 21px;
+}
+.hp-rail nav button[aria-current="page"]::before {
+  width: 3px;
+  inset-block: 15px;
+}
+.hp-rail .hp-account-button {
+  border: 1px solid var(--hp-rail-hover);
+  border-radius: 50%;
+}
+
+/* Compact creation and quiet groups give real conversation records priority. */
+.hp-shell .hp-sidebar__header,
+.hp-sidebar-drawer .hp-sidebar__header {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) 36px;
+  align-items: center;
+  min-height: 90px;
+  padding: 22px 18px 12px;
+  gap: 12px;
+}
+.hp-sidebar__header h2 {
+  font-size: 19px;
+  letter-spacing: -0.4px;
+}
+.hp-sidebar__header .rt-Button {
+  width: 36px;
+  min-height: 36px;
+  padding: 0;
+  background: var(--hp-surface);
+  color: var(--hp-accent);
+  border: 1px solid var(--hp-control-border);
+  border-radius: 10px;
+}
+.hp-sidebar-create-label {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+}
+.hp-conversation-search {
+  margin: 8px 18px 14px;
+}
+.hp-conversation-filter {
+  min-height: 40px;
+  font-size: 12px;
+  border-radius: 10px;
+}
+.hp-sidebar__list {
+  padding: 0 12px 18px;
+}
+.hp-conversation-group {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  margin: 20px 6px 10px;
+  font-size: 11px;
+}
+.hp-conversation-group::after {
+  content: "";
+  height: 1px;
+  flex: 1;
+  background: var(--hp-border);
+}
+.hp-shell .hp-conv,
+.hp-sidebar-drawer .hp-conv {
+  position: relative;
+  grid-template-columns: 32px minmax(0, 1fr);
+  column-gap: 10px;
+  row-gap: 4px;
+  min-height: 64px;
+  padding: 12px 10px;
+  border-radius: 12px;
+  margin-bottom: 6px;
+}
+.hp-conv .hp-conv-icon {
+  grid-row: 1 / 3;
+  width: 32px;
+  height: 32px;
+  padding: 7px;
+  border-radius: 9px;
+  background: var(--hp-subtle);
+}
+.hp-conv-title {
+  font-weight: 550;
+}
+.hp-conv-time {
+  grid-column: 2;
+  text-align: left;
+  font-size: 11px;
+}
+.hp-conv--active::before {
+  content: "";
+  position: absolute;
+  inset-block: 16px;
+  left: 0;
+  width: 2px;
+  background: var(--hp-brand);
+  border-radius: 2px;
+}
+
+/* Two levels in the header; the actual title editor and actions stay intact. */
+.hp-canvas-header {
+  min-height: 78px;
+  padding: 16px 26px;
+  gap: 16px;
+}
+.hp-canvas-heading {
+  flex: 1 1 180px;
+  min-width: 0;
+  display: grid;
+  gap: 5px;
+}
+.hp-page-context {
+  font-size: 11px;
+  line-height: 16px;
+  letter-spacing: 0.08em;
+  color: var(--hp-muted);
+}
+.hp-canvas-header h1 {
+  font-size: 18px;
+  letter-spacing: -0.4px;
+  line-height: 26px;
+}
+.hp-conversation-header {
+  flex: none;
+}
+.hp-canvas-actions {
+  gap: 8px;
+}
+.hp-canvas-header button {
+  border-radius: 9px;
+  min-height: 36px;
+}
+
+/* Shared centered reading column, independent from the persistent composer. */
+.hp-thread__viewport {
+  background: var(--hp-canvas);
+  padding: 36px max(24px, calc((100% - var(--hp-content)) / 2)) 24px;
+}
+.hp-msg {
+  position: relative;
+  display: block;
+  margin-bottom: 30px;
+}
+.hp-msg__marker--assistant {
+  position: absolute;
+  left: 0;
+  top: 0;
+  width: 28px;
+  height: 28px;
+  border-radius: 9px;
+}
+.hp-msg__marker--assistant svg {
+  width: 18px;
+  height: 18px;
+}
+.hp-msg__meta {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-height: 28px;
+  padding-left: 38px;
+  font-size: 12px;
+  line-height: 20px;
+}
+.hp-msg__meta > span {
+  font-weight: 650;
+}
+.hp-msg__meta time {
+  margin-left: auto;
+  font-size: 11px;
+  color: var(--hp-muted);
+}
+.hp-msg__body {
+  gap: 10px;
+}
+.hp-msg[data-role="assistant"] .hp-text-part {
+  padding: 22px;
+  border: 1px solid var(--hp-border);
+  border-radius: 16px;
+  background: var(--hp-surface);
+  box-shadow: 0 3px 14px var(--hp-shadow);
+}
+.hp-text-part {
+  font-size: 14px;
+  line-height: 1.85;
+}
+.hp-msg[data-role="user"] {
+  display: flex;
+  justify-content: flex-end;
+}
+.hp-msg__marker--user {
+  display: none;
+}
+.hp-msg[data-role="user"] .hp-msg__body {
+  flex: 0 1 auto;
+  max-width: 90%;
+}
+.hp-msg[data-role="user"] .hp-msg__meta {
+  order: 2;
+  padding: 0;
+  justify-content: flex-end;
+  min-height: 18px;
+  color: var(--hp-muted);
+}
+.hp-msg[data-role="user"] .hp-msg__meta time {
+  margin: 0;
+}
+.hp-msg:has(.hp-msg__marker--user) .hp-text-part {
+  padding: 12px 18px;
+  border-radius: 14px 14px 4px 14px;
+  font-size: 14px;
+}
+.hp-thread__viewport > .hp-execution-block {
+  margin-left: 0;
+  width: 100%;
+}
+.hp-execution-block {
+  background: var(--hp-surface);
+  padding: 16px;
+  border-radius: 12px;
+}
+.hp-artifact-message-items .hp-artifact-message-card {
+  padding: 16px;
+  border-radius: 14px;
+}
+.hp-artifact-message-icon {
+  padding: 8px;
+}
+.hp-artifact-message-copy strong {
+  font-size: 14px;
+}
+.hp-artifact-message-items > button:not(.hp-artifact-message-card) {
+  font-size: 12px;
+  min-height: 34px;
+}
+.hp-artifact-message-open {
+  border: 0;
+  padding: 0;
+}
+.hp-thread-empty {
+  min-height: 100%;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  text-align: center;
+  padding: 24px;
+}
+.hp-thread-empty-icon {
+  display: grid;
+  place-items: center;
+  width: 64px;
+  height: 64px;
+  border: 1px solid var(--hp-border);
+  border-radius: 20px;
+  background: var(--hp-surface);
+  color: var(--hp-neutral);
+  margin-bottom: 20px;
+}
+.hp-thread-empty p {
+  margin: 0 0 10px;
+}
+.hp-thread-empty > p:last-child {
+  color: var(--hp-muted);
+  font-size: 13px;
+  line-height: 1.8;
+}
+
+.hp-composer {
+  align-self: center;
+  width: min(var(--hp-content), calc(100% - 48px));
+  margin: 0 0 24px;
+  padding: 14px;
+  gap: 8px;
+  min-height: 116px;
+  border-radius: 16px;
+  box-shadow: 0 6px 22px var(--hp-shadow);
+}
+.hp-composer__input {
+  flex: 0 0 100%;
+  width: 100%;
+  min-width: 0;
+  min-height: 44px;
+  font-size: 14px;
+  line-height: 22px;
+  padding: 4px;
+}
+.hp-mode-select {
+  min-height: 36px;
+  font-size: 12px;
+  padding: 4px 8px;
+  border-radius: 8px;
+}
+.hp-composer__attach,
+.hp-file-candidates summary,
+.hp-composer button.hp-resource-use {
+  min-height: 36px;
+  font-size: 12px;
+}
+.hp-composer button.hp-composer__action {
+  width: 38px;
+  height: 38px;
+  min-width: 38px;
+  border-radius: 11px;
+}
+
+/* The inspector becomes a compact stack of real information, never a mock dashboard. */
+.hp-inspector .hp-surface-header {
+  min-height: 78px;
+  padding: 14px 16px;
+}
+.hp-inspector .hp-surface-header h2 {
+  font-size: 15px;
+}
+.hp-inspector .hp-inspector-expand {
+  font-size: 11px;
+}
+.hp-inspector > .hp-surface-body {
+  padding: 18px 16px;
+}
+.hp-inspector-tabs {
+  margin: 14px 0 18px;
+}
+.hp-inspector-tabs button {
+  font-size: 12px;
+  padding: 10px 8px;
+}
+.hp-inspector-card {
+  background: var(--hp-surface);
+  border: 1px solid var(--hp-border);
+  border-radius: 14px;
+  padding: 18px;
+  margin-top: 16px;
+  font-size: 13px;
+  line-height: 1.8;
+}
+.hp-inspector-card h3 {
+  margin: 0 0 14px;
+  font-size: 16px;
+}
+.hp-inspector-card > p {
+  margin: 12px 0;
+}
+.hp-inspector-card:has(.hp-task-actions) .hp-task-actions {
+  padding-top: 16px;
+  border-top: 1px solid var(--hp-border);
+}
+.hp-run-inspector > button {
+  width: 100%;
+  background: var(--hp-subtle);
+}
+.hp-run-inspector dl {
+  display: grid;
+  gap: 12px;
+  margin-block: 20px;
+}
+.hp-run-inspector dl > div {
+  display: grid;
+  gap: 4px;
+}
+.hp-run-inspector dt {
+  color: var(--hp-muted);
+  font-size: 11px;
+}
+.hp-run-inspector dd {
+  margin: 0;
+  font-size: 12px;
+  overflow-wrap: anywhere;
+}
+.hp-task-inspector > h3 {
+  margin: 0 0 8px;
+  font-size: 18px;
+  line-height: 1.5;
+}
+.hp-task-inspector > p {
+  color: var(--hp-muted);
+  font-size: 12px;
+  line-height: 1.8;
+}
+.hp-file-inspector h3 {
+  font-size: 18px;
+  margin-top: 0;
+}
+.hp-file-actions {
+  gap: 8px;
+  padding: 12px 0;
+}
+.hp-file-actions a {
+  display: inline-flex;
+  align-items: center;
+  min-height: 36px;
+}
+.hp-file-preview {
+  padding: 18px;
+  border-radius: 14px;
+}
+.hp-artifact-heading {
+  padding: 18px 16px 14px;
+  gap: 10px;
+}
+.hp-artifact-heading-icon {
+  width: 20px;
+  height: 20px;
+  padding: 8px;
+}
+.hp-artifact-heading h3 {
+  font-size: 16px;
+}
+.hp-artifact-inspector .hp-inspector-tabs {
+  padding-inline: 16px;
+}
+.hp-artifact-content {
+  padding: 16px;
+}
+.hp-artifact-toolbar {
+  padding-inline: 16px;
+}
+.hp-artifact-toolbar button {
+  font-size: 12px;
+}
+
+/* Workspace and Tasks use the same deliberate content density. */
+.hp-screen-scroll {
+  padding: 32px;
+}
+.hp-workspace-screen,
+.hp-task-screen {
+  width: 100%;
+  max-width: 1100px;
+  margin-inline: auto;
+}
+.hp-workspace-screen > .hp-operation-form {
+  padding-top: 24px;
+}
+.hp-file-table {
+  background: var(--hp-surface);
+  border: 1px solid var(--hp-border);
+}
+.hp-file-table th {
+  background: var(--hp-subtle);
+}
+.hp-file-table td {
+  height: 62px;
+}
+.hp-workspace-screen .hp-file-name {
+  font-weight: 550;
+}
+.hp-workspace-search {
+  margin-bottom: 24px;
+}
+.hp-workspace-sidebar,
+.hp-task-sidebar {
+  padding: 26px 16px;
+}
+.hp-workspace-sidebar h2,
+.hp-task-sidebar h2 {
+  font-size: 19px;
+  margin: 0 0 24px;
+}
+.hp-task-sidebar button {
+  padding: 14px 12px;
+  border-radius: 12px;
+}
+.hp-task-sidebar > p {
+  font-size: 12px;
+  margin-bottom: 24px;
+}
+.hp-task-toolbar {
+  padding: 0 0 24px;
+}
+.hp-task-screen > h2 {
+  font-size: 22px;
+  margin-bottom: 8px;
+}
+.hp-task-screen > [role="status"] {
