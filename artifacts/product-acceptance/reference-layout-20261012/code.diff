+}
+.hp-task-row {
+  border-radius: 16px;
+  padding: 22px;
+  margin-bottom: 16px;
+}
+.hp-task-row-heading .hp-task-title {
+  font-size: 16px;
+}
+.hp-task-objective {
+  margin: 14px 0 10px;
