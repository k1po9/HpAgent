# 首次上线逐项确认：docs/operations/first-release-configuration.md
# 本模板保持本地开发默认值；生产值在确认后填写到不提交的 .env。
# PostgreSQL roles used by Compose
HPAGENT_MIGRATE_PASSWORD=change-me
HPAGENT_API_PASSWORD=change-me
HPAGENT_WORKER_PASSWORD=change-me
# Required even in development; independent passwords. Use URL-safe random hex for Hindsight DSN.
TEMPORAL_DB_PASSWORD=
HINDSIGHT_DB_PASSWORD=

# Web security and bootstrap credentials
HPAGENT_ENV=development
WEB_PUBLIC_ORIGIN=http://127.0.0.1:5173
WEB_COOKIE_SECURE=false
WEB_CURSOR_ACTIVE_KEY_ID=v1
WEB_CURSOR_SECRET=change-me
WEB_SESSION_TOKEN_PEPPER=change-me
WEB_CSRF_SIGNING_KEY=change-me
QQ_BINDING_CODE_PEPPER=change-me-at-least-32-bytes-long
QQ_BINDING_CHALLENGE_SECONDS=300

# Model section A: provider credentials. Actual values belong only in private .env.
# Routing is selected in config/models.yaml; catalogue entries alone do not enable a model.
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=

# Model section B: provider catalogue. These are model IDs, not Account access tiers.
# MiniMax text catalogue: optional candidates; currently Hindsight defaults to STANDARD.
MINIMAX_FLAGSHIP_MODEL=
MINIMAX_STANDARD_MODEL=
MINIMAX_HIGHSPEED_MODEL=
# Current Worker routing: FLAGSHIP=reasoning, STANDARD=chat/Research/HTML, HIGHSPEED=fast.
SILICONFLOW_FLAGSHIP_MODEL=
SILICONFLOW_STANDARD_MODEL=
SILICONFLOW_HIGHSPEED_MODEL=
# SiliconFlow: Tool RAG and Hindsight both use these embedding/rerank IDs.
SILICONFLOW_EMBEDDING_MODEL=
SILICONFLOW_RERANK_MODEL=

# Model section C: Hindsight has its OWN adapter; it does not read models.yaml.
# "openai" is the compatibility protocol, not necessarily the OpenAI vendor.
# Keep variable aliases UNQUOTED (or double-quoted); single quotes make them literal in Compose.
# Place this section after section A/B so .env interpolation can resolve earlier values.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=${MINIMAX_API_BASE_URL}
HINDSIGHT_API_LLM_API_KEY=${MINIMAX_API_KEY}
HINDSIGHT_API_LLM_MODEL=${MINIMAX_STANDARD_MODEL}

# Optional QQ channels
NAPCAT_ACCOUNT=
NAPCAT_QUICK_PASSWORD=
QQ_OFFICIAL_APP_ID=
QQ_OFFICIAL_CLIENT_SECRET=
QQ_OFFICIAL_SANDBOX=false

# Runtime options
LOG_LEVEL=INFO
WORKSPACE_ISOLATION_MODE=single_process_account_lock
WEB_GATEWAY_BIND_ADDRESS=127.0.0.1
WEB_GATEWAY_PORT=80
HPAGENT_MODELS_PATH=/app/config/models.yaml
# Execution segments use short leases; all Web Runs use the canonical lifecycle.
AGENT_EXECUTION_LEASE_TTL_SECONDS=900

# File Assistant output tools are exposed only with both flags enabled.
WEB_FILE_UPLOAD_ENABLED=true
WEB_FILE_TRANSFORM_ENABLED=true
WEB_FILE_SHELL_ENABLED=false
FILE_MAX_BYTES=33554432
FILE_MAX_COUNT_PER_MESSAGE=5
FILE_CLEANUP_INTERVAL_SECONDS=300
RUN_BUDGET_MODE=enforce
GOTENBERG_URL=http://gotenberg:3000
FILE_DIRECT_READ_MAX_BYTES=1048576
GOTENBERG_IMAGE=gotenberg/gotenberg@sha256:87c16b9f364279d321bc9772d31fa58aa6abe036423c270698bd636c3a8e9466

# Shared Web Retriever (Main and background Work use the same service).
# Defaults remain legacy/local. For the verified backend Search+Text path,
# set WEB_RETRIEVAL_SEARCH_PROVIDER=deepseek and supply the separate retrieval key.
# DEEPSEEK_API_KEY below is for models; it does not enable Search/Fetch.
WEB_RETRIEVAL_SEARCH_PROVIDER=legacy
WEB_RETRIEVAL_FETCH_PROVIDER=local
DEEPSEEK_API_SEARCH_FETCH=
# Legacy Search uses SearXNG. Local Fetch requires direct public-web access;
# the shared retriever does not use HTTP_PROXY/HTTPS_PROXY or a browser fallback.
SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=change-me
SEARXNG_IMAGE=searxng/searxng@sha256:b36af7984b87191b595bc5301418ed6432c047668a4547ab531a7439b816fac3

# Optional WSL/Docker proxy. Export these in the invoking shell when the proxy
# host is dynamic; Compose passes them to image builds and Research runtimes.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,searxng,gotenberg,app-postgres,redis,temporal,hindsight,hpagent,hpagent-api,hpagent-document-worker,temporal-postgres,hindsight-postgres,web-gateway

# DeepSeek OpenAI-compatible runtime acceptance / optional model provider.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_STANDARD_MODEL=
DEEPSEEK_FLAGSHIP_MODEL=
DEEPSEEK_HIGHSPEED_MODEL=

# Artifact generation can take longer than chat; connect timeout stays at <=5s.
ARTIFACT_MODEL_READ_TIMEOUT_SECONDS=90

# Application image references. Confirm release tags before first production launch.
HPAGENT_IMAGE=hpagent/hpagent:offline
HPAGENT_API_IMAGE=hpagent/hpagent-api:offline
HPAGENT_DOCUMENT_IMAGE=hpagent/hpagent-document:offline
HPAGENT_MIGRATE_IMAGE=hpagent/hpagent-migrate:offline
WEB_GATEWAY_IMAGE=hpagent/web-gateway:offline

# Beta candidate capacity, independently counted per resource.
WORK_ACCOUNT_COORDINATORS=3
WORK_GLOBAL_COORDINATORS=16
CAPACITY_MODEL_GLOBAL=8
CAPACITY_MODEL_INTERACTIVE_RESERVED=3
CAPACITY_MODEL_ACCOUNT=2
CAPACITY_TOOL_GLOBAL=8
CAPACITY_TOOL_INTERACTIVE_RESERVED=3
CAPACITY_TOOL_ACCOUNT=2
CAPACITY_FETCH_GLOBAL=8
CAPACITY_FETCH_INTERACTIVE_RESERVED=3
CAPACITY_FETCH_ACCOUNT=2

# Beta must pin an owner-verified NapCat tag/digest; do not infer one from latest.
NAPCAT_IMAGE=

# Required when using docker-compose.beta.yaml. Fill after choosing WSL/Docker total budget.
BETA_APP_POSTGRES_CPUS=
BETA_APP_POSTGRES_MEMORY=
BETA_REDIS_CPUS=
BETA_REDIS_MEMORY=
BETA_SEARXNG_CPUS=
BETA_SEARXNG_MEMORY=
BETA_GOTENBERG_CPUS=
BETA_GOTENBERG_MEMORY=
BETA_TEMPORAL_POSTGRES_CPUS=
BETA_TEMPORAL_POSTGRES_MEMORY=
BETA_TEMPORAL_CPUS=
BETA_TEMPORAL_MEMORY=
BETA_HINDSIGHT_POSTGRES_CPUS=
BETA_HINDSIGHT_POSTGRES_MEMORY=
BETA_HINDSIGHT_CPUS=
BETA_HINDSIGHT_MEMORY=
BETA_HPAGENT_MIGRATE_CPUS=
BETA_HPAGENT_MIGRATE_MEMORY=
BETA_HPAGENT_CPUS=
BETA_HPAGENT_MEMORY=
BETA_HPAGENT_API_CPUS=
BETA_HPAGENT_API_MEMORY=
BETA_HPAGENT_DOCUMENT_WORKER_CPUS=
BETA_HPAGENT_DOCUMENT_WORKER_MEMORY=
BETA_WEB_GATEWAY_CPUS=
BETA_WEB_GATEWAY_MEMORY=
BETA_NAPCAT_CPUS=
BETA_NAPCAT_MEMORY=
