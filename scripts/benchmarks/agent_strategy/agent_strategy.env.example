# Copy values into your shell or a local ignored file. Never commit real secrets.
HPAGENT_BENCHMARK_BASE_URL=http://127.0.0.1:8000
HPAGENT_BENCHMARK_ORIGIN=http://127.0.0.1:5173
HPAGENT_BENCHMARK_USERNAME=agent-benchmark-user
HPAGENT_BENCHMARK_PASSWORD=replace-with-local-benchmark-password

# Must be this authenticated benchmark account's existing Git repo workspace:
# <WORKSPACE_ROOT>/<account_id>/repo
HPAGENT_BENCHMARK_WORKSPACE=/absolute/path/to/.data/workspace/<account_id>/repo

# Read-only metrics query. The runner never records this value in artifacts.
APP_DATABASE_URL=postgresql://hpagent_api:replace@127.0.0.1:5432/hpagent
WORKER_DATABASE_URL=postgresql://hpagent_worker:replace@127.0.0.1:5432/hpagent
